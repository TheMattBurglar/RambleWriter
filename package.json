{
  "name": "ramblewriter",
  "private": true,
  "version": "0.0.0",
  "main": "dist-electron/main.js",
  "author": {
    "name": "TheMattBurglar",
    "email": "jacenlinux@gmail.com"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:compile": "tsc -p tsconfig.electron.json",
    "electron:dev": "concurrently -k \"npm run dev\" \"npm run electron:compile -- -w\" \"wait-on http://localhost:5173 && VITE_DEV_SERVER_URL=http://localhost:5173 ELECTRON_OZONE_PLATFORM_HINT=x11 electron .\"",
    "package": "npm run build && npm run electron:compile && electron-builder build --linux"
  },
  "build": {
    "appId": "com.ramblewriter.app",
    "productName": "RambleWriter",
    "directories": {
      "output": "dist-packaged"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office;Utility;TextEditor;",
      "icon": "public/favicon.svg"
    }
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "dompurify": "^3.4.5",
    "lucide-react": "^1.16.0",
    "marked": "^18.0.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/dompurify": "^3.2.0",
    "@types/marked": "^6.0.0",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  }
}
